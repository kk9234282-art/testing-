{
  "name": "marketplace-india",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-audit.cjs",
    "typecheck:scanner": "tsc --project tsconfig.scanner.json",
    "test:scanner": "python3 -m unittest discover -s scanner_service/tests -v",
    "test:scanner:browser": "node scripts/structure-browser.cjs",
    "scanner:demo": "python3 -m scanner_service.demo"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.1",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  }
}
