# Copy to .env.scanner (gitignored) and supply your own random values.
SCANNER_DB_PASSWORD=replace-with-a-long-random-database-password
SCANNER_ADMIN_TOKEN=replace-with-a-different-long-random-service-token
# Local bridge for the existing Node/Vite app; set in the shell running npm dev.
SCANNER_SERVICE_URL=http://127.0.0.1:3002
